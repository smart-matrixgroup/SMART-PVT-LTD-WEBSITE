---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | SMART [PVT] LTD" description="This page does not exist." path="/404" noindex>
  <main class="nf">
    <img src="/img/head-440.webp" width="220" height="220" alt="" />
    <h1>This page does not exist.</h1>
    <p>The link may be old or mistyped.</p>
    <a href="/">Go to the home page</a>
  </main>
</Base>
<style>
  .nf { min-height: 100dvh; display: grid; place-content: center; justify-items: center; text-align: center; gap: 14px; padding: 24px;
    background: radial-gradient(600px 400px at 50% 35%, rgba(37,99,255,0.3), transparent 60%), #040817; color: #eef2f9; font-family: var(--body); }
  h1 { font-family: var(--display); font-weight: 500; letter-spacing: -0.03em; font-size: clamp(26px, 4vw, 40px); margin: 10px 0 0; }
  p { margin: 0; color: rgba(238,242,249,0.7); }
  a { margin-top: 10px; display: inline-flex; align-items: center; height: 50px; padding: 0 24px; border-radius: 999px; background: #2563ff; color: #fff; text-decoration: none; font-weight: 600; }
</style>
