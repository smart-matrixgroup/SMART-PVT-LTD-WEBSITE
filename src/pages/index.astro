---
import Base from '../layouts/Base.astro';
import Desktop from '../components/desktop/Desktop.astro';
import MobileApp from '../components/mobile/MobileApp.astro';
import Icon from '../components/Icon.astro';
import { company, services, faqs, SITE_URL } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE_URL}/#webpage`,
  url: `${SITE_URL}/`,
  name: 'SMART [PVT] LTD | Software, websites and apps in Sri Lanka',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#organization` },
};
// UI strings the scripts use. Values are English here; the i18n build step
// translates them for /ta and /si (keys stay the same).
const ui = {
  showPrice: 'Show price',
  hidePrice: 'Hide price',
  readyIn: 'Ready in {x}.',
  waAsk: "Hi SMART, I'm interested in {x}. Can you tell me more?",
  waInterested: "Hi SMART, I'm interested in {x}.",
  waFormHello: "Hi SMART, I'm {name}.",
  waFormFrom: "Hi SMART, I'm {name} from {business}.",
  waFormService: "I'm interested in: {service}.",
  Services: 'Services',
  'Our Work': 'Our Work',
  About: 'About',
  Contact: 'Contact',
};
const siteData = { wa: company.contact.whatsapp, services, ui };
---
<Base
  title="SMART [PVT] LTD | Software Company in Trincomalee, Sri Lanka | Websites & Apps"
  description="SMART (Pvt) Ltd is a registered software company in Trincomalee, Sri Lanka. Websites from LKR 14,999, restaurant ordering systems, mobile apps, POS, WhatsApp AI and custom software. Call +94 789 999 687."
  jsonLd={[pageLd, faqLd]}
>
  <Desktop />
  <MobileApp />

  <script type="application/json" id="site-data" set:html={JSON.stringify(siteData)} />
  {services.map((s) => (
    <template data-icon={s.id}><Icon name={s.icon} size={26} /></template>
  ))}
</Base>
