---
import Icon from '../Icon.astro';
import Price from '../Price.astro';
import Social from '../Social.astro';
import '../../styles/desktop.css';
import { company, services, projects, process, faqs, visibleTestimonials, waLink, isDev, directionsUrl } from '../../data/site';

const featured = services.filter((s) => ['portfolio-website', 'restaurant-ordering'].includes(s.id));
const others = services.filter((s) => !featured.includes(s));
const c = company.contact;
const mapQuery = [c.address, `${c.city} ${c.postalCode}`.trim(), c.country].filter(Boolean).join(', ');
const year = new Date().getFullYear();
const problems = [
  { id: 'portfolio-website', text: 'Nobody finds me online' },
  { id: 'restaurant-ordering', text: 'Delivery apps take my profit' },
  { id: 'kadabook', text: 'Shop accounts on paper' },
  { id: 'whatsapp-ai', text: 'Too many WhatsApp messages' },
  { id: 'digital-marketing', text: 'Nobody knows my business' },
  { id: 'mobile-apps', text: 'I have an app idea' },
  { id: 'websites-web-apps', text: 'Customers need to book online' },
  { id: 'custom-software', text: 'Spreadsheets slow us down' },
];
const first = services.find((s) => s.id === problems[0].id)!;
const kbFeatures = [
  { icon: 'cart', tone: 'green', label: 'Sales' },
  { icon: 'bookopen', tone: 'orange', label: 'Credit book' },
  { icon: 'users', tone: 'blue', label: 'Customers' },
  { icon: 'package', tone: 'violet', label: 'Stock' },
  { icon: 'chart', tone: 'indigo', label: 'Reports' },
  { icon: 'chef', tone: 'amber', label: 'Kitchen' },
  { icon: 'usercog', tone: 'pink', label: 'Staff' },
  { icon: 'printer', tone: 'cyan', label: 'Printing' },
] as const;
---
<div class="desktop" id="desktop">
  <header class="nav" data-nav>
    <a href="#top" class="nav-brand" aria-label="SMART home">
      <img src="/img/head-180.webp" width="40" height="40" alt="" />
      <img src="/img/wordmark-dark.webp" width="118" height="63" alt="SMART [PVT] LTD" class="nav-word" />
    </a>
    <nav aria-label="Main">
      <ul class="nav-links">
        <li><a href="#services">Services</a></li>
        <li><a href="#products">Products</a></li>
        <li><a href="#work">Work</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
    <a class="btn btn-primary btn-sm" href={waLink('Hi SMART, I would like to talk about a project.')} target="_blank" rel="noopener">
      <Icon name="whatsapp" size={18} /> Start a project
    </a>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true"></div>
      <canvas class="hero-canvas" data-neural aria-hidden="true"></canvas>
      <div class="hero-veil" aria-hidden="true"></div>
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="hero-kicker"><span class="live-dot"></span>Software company in Trincomalee, Sri Lanka</p>
          <h1 id="hero-title" class="hero-title">
            <span class="ln"><span>Tell us the problem.</span></span>
            <span class="ln"><span class="sheen">We build the fix.</span></span>
          </h1>

          <div class="picker" data-picker>
            <p class="picker-q" id="picker-q">What is holding your business back?</p>
            <div class="chips" role="radiogroup" aria-labelledby="picker-q">
              {problems.map((p, i) => (
                <button type="button" class="chip" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-pick={p.id}>
                  <span class="chip-dot" aria-hidden="true"></span>{p.text}
                </button>
              ))}
            </div>

            <div class="answer" data-answer aria-live="polite">
              <span class="answer-ico logo" data-a="icon"><img src={first.logo} width="56" height="56" alt="" /></span>
              <div class="answer-main">
                <p class="answer-k">Our fix</p>
                <p class="answer-name" data-a="name">{first.name}</p>
                <p class="answer-short" data-a="short">{first.short}</p>
              </div>
              <div class="answer-side">
                <p class="answer-price"><Price value={first.price} vAttrs={{ "data-a": "price" }} /></p>
                <div class="answer-act">
                  <button type="button" class="btn btn-ghost btn-sm" data-service={first.id} data-a="more">What is included</button>
                  <a class="answer-wa" data-a="wa" href={waLink(`Hi SMART, I'm interested in ${first.name}.`)} target="_blank" rel="noopener" aria-label="Ask on WhatsApp"><Icon name="whatsapp" size={22} /></a>
                </div>
              </div>
              <span class="answer-bar" aria-hidden="true"></span>
            </div>
          </div>
        </div>

        <div class="stage" data-stage>
          <div class="stage-ring" aria-hidden="true"></div>
          <div class="head-wrap" aria-hidden="true">
            <div class="head-glow"></div>
            <img class="head" src="/img/head-880.webp"
              srcset="/img/head-440.webp 440w, /img/head-880.webp 880w" sizes="440px"
              width="440" height="440" alt="" fetchpriority="high" decoding="async" />
            <span class="core-pulse"></span>
            <span class="core-pulse d2"></span>
          </div>
          <ul class="orbit" data-orbit aria-label="Our services">
            {services.map((s) => (
              <li class="orbit-item">
                <button class="orbit-node" type="button" data-service={s.id} aria-label={s.name}>
                  <span class="orbit-ico"><img src={s.logo} width="34" height="34" alt="" /></span>
                  <span class="orbit-label">{s.orbit}</span>
                </button>
              </li>
            ))}
          </ul>
          <p class="stage-hint">Click any service to see what is included</p>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="sec light" id="services" aria-labelledby="services-title">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="services-title" class="h2">Services with clear price ranges.</h2>
          <p class="lede" data-rv="up">Every business needs something a little different, so each service has a range. Tell us what you need and we agree one exact price before any work starts.</p>
        </div>

        <div class="featured" data-rv-group="lift">
          {featured.map((s) => (
            <article class="feat-card" data-spot>
              <div class="feat-top">
                <span class="logo lg"><img src={s.logo} width="72" height="72" alt="" loading="lazy" /></span>
                {s.badge && <span class="badge">{s.badge}</span>}
              </div>
              <h3 class="h3">{s.name}</h3>
              <p class="feat-short">{s.short}</p>
              <p class="feat-for"><strong>For</strong> {s.forWho}</p>
              <ul class="ticks">
                {s.includes.slice(0, 4).map((i) => <li><Icon name="check" size={18} stroke={2} />{i}</li>)}
              </ul>
              <div class="feat-foot">
                <div>
                  <p class="price"><Price value={s.price} /></p>
                  <p class="price-note">{s.priceNote}{s.delivery && <> Ready in {s.delivery}.</>}</p>
                </div>
                <button type="button" class="btn btn-dark" data-service={s.id}>See everything included</button>
              </div>
            </article>
          ))}
        </div>

        <ul class="svc-list" data-rv-group="up">
          {others.map((s) => (
            <li class="svc-li">
              <button type="button" class="svc-row" data-service={s.id}>
                <span class="logo"><img src={s.logo} width="52" height="52" alt="" loading="lazy" /></span>
                <span class="svc-main">
                  <span class="svc-name">{s.name}{s.badge && <span class="badge sm">{s.badge}</span>}</span>
                  <span class="svc-short">{s.short}</span>
                </span>
                <span class="svc-go"><Icon name="arrow" size={20} /></span>
              </button>
              <span class="svc-price"><Price value={s.price} /></span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- PRODUCTS -->
    <section class="sec dark products" id="products" aria-labelledby="products-title">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="products-title" class="h2 chrome">Products we built ourselves.</h2>
          <p class="lede" data-rv="up">We do not just build for clients. These are ours, and we run them every day.</p>
        </div>
        <div class="prod-grid" data-rv-group="lift">
          <article class="prod" data-spot>
            <div class="prod-copy">
              <img class="prod-logo" src="/img/svc/kadabook.webp" width="64" height="64" alt="KadaBook logo" loading="lazy" />
              <span class="badge glow">Coming to Google Play</span>
              <h3 class="h3">KadaBook</h3>
              <p>Billing, stock and a credit book for every Sri Lankan shop, on the phone the owner already has. English, Tamil and Sinhala.</p>
              <div class="prod-links">
                <a class="btn btn-primary btn-sm" href="https://kadabook.app" target="_blank" rel="noopener">Visit kadabook.app</a>
                <button type="button" class="link-btn" data-service="kadabook">What it does <Icon name="arrow" size={18} /></button>
              </div>
            </div>
            <div class="phone real" aria-hidden="true">
              <div class="phone-screen">
                <img class="ui-a" src="/img/kadabook-ui-home.webp" width="390" height="844" alt="" loading="lazy" decoding="async" />
                <img class="ui-b" src="/img/kadabook-ui-sale.webp" width="390" height="844" alt="" loading="lazy" decoding="async" />
              </div>
            </div>
          </article>
          <article class="prod" data-spot>
            <div class="prod-copy">
              <img class="prod-logo" src="/img/svc/whatsapp-ai.svg" width="64" height="64" alt="" loading="lazy" />
              <span class="badge glow">New service</span>
              <h3 class="h3">WhatsApp AI Assistant</h3>
              <p>Answers prices, opening hours and orders the moment a customer asks, even at midnight, and hands the chat to you when it needs a person.</p>
              <button type="button" class="link-btn" data-service="whatsapp-ai">How it works <Icon name="arrow" size={18} /></button>
            </div>
            <div class="phone" aria-hidden="true">
              <div class="phone-screen wa" data-chat>
                <div class="wa-head"><span class="wa-av"></span><span>Your Business<small>online</small></span></div>
                <div class="wa-body">
                  <p class="bub in">Hi, do you deliver to Nilaveli?</p>
                  <p class="bub out">Yes! Delivery to Nilaveli is LKR 350 and takes about 40 minutes. Shall I send today's menu?</p>
                  <p class="bub in">Yes please</p>
                  <p class="bub out">Here it is. Reply with the item numbers and I will confirm your order.</p>
                </div>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- WORK -->
    <section class="sec light" id="work" aria-labelledby="work-title">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="work-title" class="h2">Live work you can open today.</h2>
          <p class="lede" data-rv="up">Real clients, real sites, online today. Open them and judge for yourself.</p>
        </div>
        <div class="work-grid" data-rv-group="lift">
          {projects.filter((p) => p.url).map((p) => (
            p.phone ? (
            <div class="kb-show">
              <div class="kb-copy">
                <img class="kb-logo" src="/img/svc/kadabook.webp" width="88" height="88" alt="KadaBook logo" loading="lazy" />
                <span class="pill">{p.status}</span>
                <h3 class="kb-title">{p.name}</h3>
                <p>{p.summary} Sales, credit book, stock, staff and printing in one app, in English, Tamil and Sinhala.</p>
                <div class="kb-actions">
                  <a class="btn btn-primary" href={p.url} target="_blank" rel="noopener">Visit kadabook.app</a>
                  <button type="button" class="btn btn-ghost-d" data-service="kadabook">What it does</button>
                </div>
              </div>
              <div class="kb-stage" aria-hidden="true">
                <div class="kb-ring">
                  {kbFeatures.map((f, i) => {
                    const a = (i / kbFeatures.length) * Math.PI * 2;
                    return (
                      <div class="kb-item" style={`left:${(50 + Math.cos(a) * 46).toFixed(2)}%;top:${(50 + Math.sin(a) * 46).toFixed(2)}%;--i:${i}`}>
                        <span class={`kb-tile tone-${f.tone}`}><Icon name={f.icon} size={26} stroke={2} /></span>
                        <span class="kb-label">{f.label}</span>
                      </div>
                    );
                  })}
                </div>
                <div class="kb-phone">
                  <div class="kb-screen">
                    <div class="kb-status"><b>9:41</b><i class="kb-island"></i><span class="kb-icons"><em></em><em></em><em></em></span></div>
                    <img src={p.image} width="390" height="844" loading="lazy" decoding="async" alt="" />
                    <div class="kb-home"><span></span></div>
                    <span class="kb-sheen"></span>
                  </div>
                </div>
                <span class="kb-shadow"></span>
              </div>
            </div>
            ) : (
            <a class="work" href={p.url} target="_blank" rel="noopener" data-tilt>
              <div class="browser">
                <div class="browser-bar"><i></i><i></i><i></i><span>{p.name}</span></div>
                <img src={p.image} width="1080" height="675" loading="lazy" decoding="async" alt={`Screenshot of ${p.name}`} />
              </div>
              <div class="work-meta">
                <div>
                  <h3 class="h4">{p.name}</h3>
                  <p>{p.summary}</p>
                </div>
                <span class="pill">{p.status ?? p.kind}</span>
              </div>
            </a>
            )
          ))}
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="sec dark about" id="about" aria-labelledby="about-title">
      <div class="wrap">
        <h2 id="about-title" class="sr-only">About SMART</h2>
        <div class="vm">
          <div>
            <h3 class="vm-label">Our vision</h3>
            <p class="vm-text">{company.vision}</p>
          </div>
          <div>
            <h3 class="vm-label">Our mission</h3>
            <p class="vm-text">{company.mission}</p>
          </div>
        </div>
        <ul class="values" data-rv-group="up">
          {company.values.map((v, i) => (
            <li>
              <span class="tile glass"><Icon name={(['shield', 'cog', 'chat', 'whatsapp'] as const)[i]} size={22} /></span>
              <h4>{v.title}</h4>
              <p>{v.text}</p>
            </li>
          ))}
        </ul>

        <div class="process">
          <h3 class="h2 chrome sm">How a project works.</h3>
          <ol class="steps" data-steps data-rv-group="up">
            <span class="steps-line" aria-hidden="true"><span></span></span>
            {process.map((p, i) => (
              <li>
                <span class="step-n">{i + 1}</span>
                <h4>{p.title}</h4>
                <p>{p.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- TRUST: testimonials + Google reviews -->
    <section class="sec light trust" aria-labelledby="trust-title">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="trust-title" class="h2">{visibleTestimonials.length ? 'What our clients say.' : 'Find us on Google.'}</h2>
        </div>
        {visibleTestimonials.length > 0 && (
          <div class="quotes" data-rv-group="lift">
            {visibleTestimonials.map((t) => (
              <figure class:list={['quote', { pending: !t.approved }]}>
                {!t.approved && <span class="dev-flag">Waiting for client OK (dev only)</span>}
                <span class="q-mark" aria-hidden="true">“</span>
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  <img src={t.photo} width="56" height="56" alt={t.name} loading="lazy" />
                  <span><b>{t.name}</b><small>{t.role}</small></span>
                </figcaption>
                {t.site && <a href={t.site} target="_blank" rel="noopener" class="q-site">{t.site.replace('https://', '')}</a>}
              </figure>
            ))}
          </div>
        )}
        <div class="greview" data-rv="up">
          <div class="g-stars" aria-hidden="true">
            {[0, 1, 2, 3, 4].map(() => <Icon name="star" size={22} stroke={1.4} />)}
          </div>
          <div class="g-copy">
            <h3 class="h4">SMART on Google</h3>
            <p>Read reviews, see photos and get directions to our Trincomalee office. Worked with us? A short review helps other businesses find us.</p>
          </div>
          {c.googleReviewUrl ? (
            <a class="btn btn-dark" href={c.googleReviewUrl} target="_blank" rel="noopener">Open our Google profile</a>
          ) : isDev ? (
            <span class="dev-flag">Add googleReviewUrl in src/data/site.ts</span>
          ) : (
            <a class="btn btn-dark" href={waLink('Hi SMART, I would like to share feedback.')} target="_blank" rel="noopener">Share feedback</a>
          )}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sec light faq-sec" aria-labelledby="faq-title">
      <div class="wrap faq-wrap">
        <div class="sec-head sticky">
          <h2 id="faq-title" class="h2">Questions people ask us.</h2>
          <p class="lede" data-rv="up">Something else on your mind? Ask on WhatsApp, a person replies.</p>
        </div>
        <div class="faq" data-rv-group="up">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}<span class="faq-x" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="sec dark contact" id="contact" aria-labelledby="contact-title">
      <div class="wrap contact-grid">
        <div>
          <h2 id="contact-title" class="h2 chrome">Tell us what you need.</h2>
          <p class="lede" data-rv="up">Send a message and we will reply with a plan and an exact price.</p>
          <ul class="c-list" data-rv-group="up">
            <li><a href={waLink('Hi SMART!')} target="_blank" rel="noopener"><span class="t3d tone-wa"><Icon name="whatsapp" size={22} stroke={1.9} /></span><span><small>WhatsApp</small>{c.phoneDisplay}</span></a></li>
            <li><a href={`tel:${c.phone}`}><span class="t3d tone-blue"><Icon name="call" size={22} stroke={1.9} /></span><span><small>Call</small>{c.phoneDisplay}</span></a></li>
            <li><a href={`mailto:${c.email}`}><span class="t3d tone-violet"><Icon name="mail" size={22} stroke={1.9} /></span><span><small>Email</small>{c.email}</span></a></li>
            <li><a href={directionsUrl} target="_blank" rel="noopener"><span class="t3d tone-orange"><Icon name="pin" size={22} stroke={1.9} /></span><span><small>Office</small>{[c.address, `${c.city} ${c.postalCode}`.trim(), c.country].filter(Boolean).join(', ')}</span></a></li>
            <li><div><span class="t3d tone-indigo"><Icon name="clock" size={22} stroke={1.9} /></span><span><small>Hours</small>{c.hours.map((h) => <>{h.days}: {h.time}<br /></>)}</span></div></li>
          </ul>
          <div class="c-social" data-rv="up">
            <p class="c-social-h">Follow SMART</p>
            <Social />
          </div>
        </div>

        <form class="c-form" data-wa-form novalidate data-rv="lift">
          <h3 class="h4">Quick message</h3>
          <label>Your name<input name="name" autocomplete="name" required /></label>
          <label>Business name<input name="business" autocomplete="organization" /></label>
          <label>I am interested in
            <select name="service">
              {services.map((s) => <option>{s.name}</option>)}
              <option>Something else</option>
            </select>
          </label>
          <label>Message<textarea name="message" rows="4" placeholder="Tell us a little about your business"></textarea></label>
          <button class="btn btn-primary wide" type="submit"><Icon name="whatsapp" size={20} /> Send on WhatsApp</button>
          <p class="form-note">Opens WhatsApp with your message ready to send.</p>
        </form>

        <a class="map-card" data-rv="lift" href={directionsUrl} target="_blank" rel="noopener" aria-label="Get directions to SMART on Google Maps (opens in a new tab)">
          <iframe title="SMART office on the map" loading="lazy" tabindex="-1" aria-hidden="true" referrerpolicy="no-referrer-when-downgrade"
            src={`https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=16&output=embed`}></iframe>
          <span class="map-shade" aria-hidden="true"></span>
          <span class="map-pin" aria-hidden="true"><img src="/img/head-180.webp" width="44" height="44" alt="" /></span>
          <span class="map-info">
            <span class="map-k">Visit our office</span>
            <span class="map-addr">{c.address}, {c.city} {c.postalCode}</span>
            <span class="map-cta"><Icon name="pin" size={18} /> Get directions from where you are</span>
          </span>
        </a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-grid">
      <div class="foot-brand">
        <img src="/img/logo-dark.webp" width="220" height="89" alt="SMART [PVT] LTD" loading="lazy" />
        <p>{company.tagline}</p>
        <Social size="sm" labels={false} class="foot-social" />
      </div>
      <div>
        <h4>Services</h4>
        <ul>{services.slice(0, 5).map((s) => <li><button type="button" data-service={s.id}>{s.name}</button></li>)}</ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#work">Our work</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Legal</h4>
        <ul>
          <li><a href="/privacy-policy">Privacy policy</a></li>
          <li><a href="/terms">Terms and conditions</a></li>
        </ul>
      </div>
    </div>
    <div class="wrap foot-base">
      <p>© {year} {company.legalName}. Registered in Sri Lanka.</p>
      <p>findoursmart.com</p>
    </div>
  </footer>

  <a class="wa-float" href={waLink('Hi SMART!')} target="_blank" rel="noopener" aria-label="Chat with SMART on WhatsApp">
    <Icon name="whatsapp" size={28} stroke={1.8} />
  </a>

  <dialog class="svc-dialog" data-dialog aria-labelledby="dlg-title">
    <div class="dlg-card" tabindex="-1" autofocus>
      <button class="dlg-close" type="button" data-close aria-label="Close"><Icon name="close" size={22} /></button>
      <div class="dlg-head">
        <span class="logo lg" data-d="icon"></span>
        <div>
          <h3 id="dlg-title" class="h3" data-d="name"></h3>
          <p class="dlg-short" data-d="short"></p>
        </div>
      </div>
      <div class="dlg-body">
        <div class="dlg-col">
          <h4>The problem it solves</h4>
          <p data-d="problem"></p>
          <h4>Made for</h4>
          <p data-d="forWho"></p>
        </div>
        <div class="dlg-col">
          <h4>What you get</h4>
          <ul class="ticks" data-d="includes"></ul>
        </div>
      </div>
      <div class="dlg-foot">
        <div>
          <p class="price"><Price vAttrs={{ "data-d": "price" }} /></p>
          <p class="price-note" data-d="note"></p>
        </div>
        <a class="btn btn-primary" data-d="cta" target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> Ask about this</a>
      </div>
    </div>
  </dialog>
