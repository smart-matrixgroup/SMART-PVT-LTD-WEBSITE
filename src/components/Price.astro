---
// A price that stays hidden (softly blurred) until the visitor taps the eye button.
// `passive` renders a non-interactive version for use inside other buttons/cards.
// `vAttrs` adds attributes to the value span (so scripts can fill it in later).
interface Props { value?: string; class?: string; passive?: boolean; vAttrs?: Record<string, string> }
const { value = '', class: cls = '', passive = false, vAttrs = {} } = Astro.props;
const eye = '<path d="M2.5 12s3.5-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.5 6.5-9.5 6.5S2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>';
const eyeOff = '<path d="M3 3l18 18M10.6 5.6A9.6 9.6 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a17 17 0 0 1-2.7 3.4M6.2 6.7C3.9 8.3 2.5 12 2.5 12s3.5 6.5 9.5 6.5c1.6 0 3-.4 4.2-1M9.9 9.9a3 3 0 0 0 4.2 4.2"/>';
---
<span class:list={['plock', cls]} data-plock>
  <span class="plock-v" data-plock-v {...vAttrs}>{value}</span>
  {passive ? (
    <span class="plock-b" aria-hidden="true">
      <svg class="i-eye" set:html={eye} width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
    </span>
  ) : (
    <button type="button" class="plock-b" data-plock-btn aria-pressed="false" aria-label="Show price" title="Show price">
      <svg class="i-eye" set:html={eye} width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" />
      <svg class="i-off" set:html={eyeOff} width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" />
      <span class="plock-t">Show price</span>
    </button>
  )}
</span>
