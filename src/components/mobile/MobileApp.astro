---
import Icon from '../Icon.astro';
import Price from '../Price.astro';
import Social from '../Social.astro';
import '../../styles/mobile.css';
import { company, services, projects, process, faqs, visibleTestimonials, waLink, isDev, directionsUrl } from '../../data/site';
import type { IconName } from '../../data/site';

const c = company.contact;
const byId = (id: string) => services.find((s) => s.id === id)!;
const popular = ['portfolio-website', 'restaurant-ordering', 'whatsapp-ai', 'kadabook'].map(byId);
const orbit = ['portfolio-website', 'restaurant-ordering', 'kadabook', 'whatsapp-ai', 'digital-marketing', 'mobile-apps'].map(byId);
const featured = ['portfolio-website', 'restaurant-ordering'].map(byId);
const rest = services.filter((s) => !featured.includes(s));
const mapQuery = [c.address, `${c.city} ${c.postalCode}`.trim(), c.country].filter(Boolean).join(', ');
const year = new Date().getFullYear();
const tabs = [
  { id: 'home', label: 'Home', icon: 'home' },
  { id: 'services', label: 'Services', icon: 'grid' },
  { id: 'work', label: 'Work', icon: 'briefcase' },
  { id: 'about', label: 'About', icon: 'info' },
  { id: 'contact', label: 'Contact', icon: 'chat' },
] as const;
const problems = [
  { id: 'portfolio-website', text: 'Nobody finds me online' },
  { id: 'restaurant-ordering', text: 'Delivery apps take my profit' },
  { id: 'kadabook', text: 'Shop accounts on paper' },
  { id: 'whatsapp-ai', text: 'Too many WhatsApp messages' },
  { id: 'digital-marketing', text: 'Nobody knows my business' },
  { id: 'mobile-apps', text: 'I have an app idea' },
];
const values: { icon: IconName; tone: string }[] = [
  { icon: 'shield', tone: 'blue' },
  { icon: 'cog', tone: 'violet' },
  { icon: 'chat', tone: 'orange' },
  { icon: 'whatsapp', tone: 'wa' },
];
const kbFeatures = [
  { icon: 'cart', tone: 'green' }, { icon: 'bookopen', tone: 'orange' }, { icon: 'users', tone: 'blue' },
  { icon: 'package', tone: 'violet' }, { icon: 'chart', tone: 'indigo' }, { icon: 'printer', tone: 'cyan' },
] as const;
const stepTones = ['blue', 'violet', 'orange', 'green'];
---
<div class="mobile" id="mobile" data-active="home">
  <header class="m-nav" data-mnav>
    <span class="m-nav-title" data-mnav-title>SMART</span>
    <a class="m-nav-btn" href={waLink('Hi SMART!')} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
      <Icon name="whatsapp" size={24} stroke={1.8} />
    </a>
  </header>

  <main class="m-main">
    <!-- ───────── HOME ───────── -->
    <section class="m-tab is-active" data-tab="home" aria-label="Home">
      <div class="m-hero">
        <div class="m-hero-bg" aria-hidden="true"></div>
        <img class="m-word" src="/img/wordmark-dark.webp" width="620" height="332" alt="SMART [PVT] LTD" />
        <div class="m-orbit-stage">
          <div class="m-halo" aria-hidden="true"></div>
          <img class="m-head" src="/img/head-440.webp" width="440" height="440" alt="" fetchpriority="high" decoding="async" />
          <span class="m-core" aria-hidden="true"></span>
          <div class="m-orbit" aria-label="Services">
            {orbit.map((s, i) => (
              <button type="button" class="m-orb" style={`--i:${i};--n:${orbit.length}`} data-service={s.id} aria-label={s.name}>
                <span class="ico orb"><img src={s.logo} width="40" height="40" alt="" /></span>
              </button>
            ))}
          </div>
        </div>
        <h2 class="m-hero-title">Websites, apps and software for your business.</h2>
        <p class="m-hero-sub">Prices from LKR 14,999. Built and supported in Trincomalee, Sri Lanka.</p>
        <div class="m-hero-cta">
          <a class="m-btn m-btn-fill" href={waLink('Hi SMART, I would like to talk about a project.')} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} stroke={1.9} />WhatsApp</a>
          <a class="m-btn m-btn-glass" href={`tel:${c.phone}`}><Icon name="call" size={20} stroke={1.9} />Call</a>
        </div>
        <p class="m-hint">Tap a logo around the head to explore</p>
      </div>

      <!-- quick actions widget -->
      <div class="m-quick m-rv">
        <a href={waLink('Hi SMART!')} target="_blank" rel="noopener"><span class="t3d tone-wa"><Icon name="whatsapp" size={24} stroke={1.9} /></span>Chat</a>
        <a href={`tel:${c.phone}`}><span class="t3d tone-blue"><Icon name="call" size={24} stroke={1.9} /></span>Call</a>
        <a href={directionsUrl} target="_blank" rel="noopener"><span class="t3d tone-orange"><Icon name="navigate" size={24} stroke={1.9} /></span>Visit</a>
        <button type="button" data-goto="services"><span class="t3d tone-violet"><Icon name="grid" size={24} stroke={1.9} /></span>Services</button>
      </div>

      <!-- problem picker widget -->
      <div class="m-card m-picker m-rv">
        <div class="m-card-h"><span class="t3d tone-indigo" style="--s:34px"><Icon name="spark" size={18} stroke={2} /></span><b>What do you need help with?</b></div>
        <div class="m-chips">
          {problems.map((p) => (
            <button type="button" class="m-chip2" data-service={p.id}>{p.text}<Icon name="chev" size={14} stroke={2.6} /></button>
          ))}
        </div>
      </div>

      <div class="m-sec-h m-rv"><h3>Popular services</h3><button type="button" data-goto="services">See all</button></div>
      <div class="m-carousel">
        {popular.map((s) => (
          <button type="button" class="m-pcard" data-service={s.id}>
            <span class="m-pcard-art" aria-hidden="true">
              <img src={s.logo} width="76" height="76" alt="" loading="lazy" />
            </span>
            {s.badge && <span class="m-chip">{s.badge}</span>}
            <span class="m-pcard-name">{s.name}</span>
            <span class="m-pcard-short">{s.short}</span>
            <span class="m-pcard-foot"><span class="m-pcard-price"><Price value={s.price} passive /></span><span class="m-go"><Icon name="chev" size={16} stroke={2.6} /></span></span>
          </button>
        ))}
      </div>

      <!-- KadaBook widget -->
      <a class="m-kb m-rv" href="https://kadabook.app" target="_blank" rel="noopener">
        <span class="m-kb-copy">
          <img src="/img/svc/kadabook.webp" width="52" height="52" alt="" loading="lazy" />
          <small>Our own app</small>
          <b>KadaBook</b>
          <span>Billing, stock and credit book for every shop.</span>
          <em>kadabook.app <Icon name="chev" size={14} stroke={2.6} /></em>
        </span>
        <span class="m-kb-stage" aria-hidden="true">
          <span class="m-kb-ring">
            {kbFeatures.map((f, i) => (
              <span class={`t3d tone-${f.tone}`} style={`--i:${i};--n:${kbFeatures.length};--s:30px`}><Icon name={f.icon} size={15} stroke={2.2} /></span>
            ))}
          </span>
          <span class="m-kb-phone"><img src="/img/kadabook-ui-home.webp" width="390" height="844" alt="" loading="lazy" /></span>
        </span>
      </a>

      <div class="m-sec-h m-rv"><h3>Live work</h3><button type="button" data-goto="work">See all</button></div>
      <div class="m-carousel">
        {projects.filter((p) => p.image && !p.phone).map((p) => (
          <a class="m-wcard" href={p.url} target="_blank" rel="noopener">
            <span class="m-wcard-frame"><i></i><i></i><i></i></span>
            <img src={p.image} width="1080" height="675" alt={`Screenshot of ${p.name}`} loading="lazy" decoding="async" />
            <span class="m-wcard-meta"><b>{p.name}</b><small>{p.kind}</small></span>
          </a>
        ))}
      </div>

      <div class="m-sec-h m-rv"><h3>Why SMART</h3></div>
      <div class="m-widgets">
        {company.values.map((v, i) => (
          <div class="m-widget m-rv" style={`--d:${i}`}>
            <span class={`t3d tone-${values[i].tone}`}><Icon name={values[i].icon} size={22} stroke={1.9} /></span>
            <b>{v.title}</b>
            <small>{v.text}</small>
          </div>
        ))}
      </div>

      {visibleTestimonials.length > 0 && (
        <>
          <div class="m-sec-h m-rv"><h3>Happy clients</h3><button type="button" data-goto="about">More</button></div>
          <div class="m-carousel">
            {visibleTestimonials.map((t) => (
              <figure class="m-quote">
                <span class="m-qmark" aria-hidden="true">{'“'}</span>
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  <img src={t.photo} width="44" height="44" alt={t.name} loading="lazy" />
                  <span><b>{t.name}</b><small>{t.role}</small></span>
                </figcaption>
              </figure>
            ))}
          </div>
        </>
      )}
      <div class="m-home-social m-rv"><Social size="sm" labels={false} /></div>
      <p class="m-foot-note">{company.tagline}</p>
    </section>

    <!-- ───────── SERVICES ───────── -->
    <section class="m-tab" data-tab="services" aria-label="Services" hidden>
      <div class="m-banner tone-banner-blue">
        <div>
          <h2 class="m-large">Services</h2>
          <p>Clear price ranges. Tap the eye to see a price.</p>
        </div>
        <span class="m-banner-art" aria-hidden="true">
          <img src="/img/svc/portfolio-website.svg" width="54" height="54" alt="" />
          <img src="/img/svc/whatsapp-ai.svg" width="46" height="46" alt="" />
          <img src="/img/svc/mobile-apps.svg" width="40" height="40" alt="" />
        </span>
      </div>
      <label class="m-search">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <span class="sr-only">Search services</span>
        <input type="search" placeholder="Search services" data-search enterkeyhint="search" />
      </label>

      <div class="m-feat" data-feat>
        {featured.map((s) => (
          <button type="button" class="m-fcard" data-service={s.id} data-search-text={`${s.name} ${s.short} ${s.forWho}`.toLowerCase()}>
            <span class="m-fcard-art"><img src={s.logo} width="64" height="64" alt="" loading="lazy" /></span>
            <b>{s.name}</b>
            <small>{s.short}</small>
            <span class="m-fcard-price"><Price value={s.price} passive /></span>
          </button>
        ))}
      </div>

      <ul class="m-group m-svc" data-svc-list>
        {rest.map((s) => (
          <li>
            <button type="button" class="m-cell m-cell-btn" data-service={s.id} data-search-text={`${s.name} ${s.short} ${s.forWho}`.toLowerCase()}>
              <span class="m-logo"><img src={s.logo} width="44" height="44" alt="" loading="lazy" /></span>
              <span class="m-cell-main"><b>{s.name}</b><small>{s.short}</small></span>
              <Icon name="chev" size={16} stroke={2.4} class="m-chev" />
            </button>
          </li>
        ))}
      </ul>
      <p class="m-empty" data-search-empty hidden>No services match. Ask us on WhatsApp, we probably do it.</p>
      <div class="m-cta-card m-rv">
        <span class="t3d tone-wa" style="--s:48px"><Icon name="whatsapp" size={24} stroke={1.9} /></span>
        <b>Not sure what you need?</b>
        <p>Tell us the problem. We will suggest the simplest fix and an exact price.</p>
        <a class="m-btn m-btn-fill wide" href={waLink('Hi SMART, I need help choosing a service.')} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} stroke={1.9} />Ask on WhatsApp</a>
      </div>
    </section>

    <!-- ───────── WORK ───────── -->
    <section class="m-tab" data-tab="work" aria-label="Our work" hidden>
      <div class="m-banner tone-banner-violet">
        <div>
          <h2 class="m-large">Our Work</h2>
          <p>Live websites and apps you can open today.</p>
        </div>
        <span class="m-banner-art" aria-hidden="true">
          <span class="t3d tone-violet" style="--s:50px"><Icon name="briefcase" size={24} stroke={1.9} /></span>
        </span>
      </div>
      <div class="m-seg" role="tablist" data-seg>
        <span class="m-seg-thumb" aria-hidden="true"></span>
        <button type="button" role="tab" aria-selected="true" data-filter="all">All</button>
        <button type="button" role="tab" aria-selected="false" data-filter="web">Websites</button>
        <button type="button" role="tab" aria-selected="false" data-filter="app">Apps</button>
      </div>
      <div class="m-work-list">
        {projects.map((p) => (
          <article class="m-work m-rv" data-kind={p.phone ? 'app' : 'web'}>
            {p.phone ? (
              <div class="m-work-ph">
                <img class="m-work-ph-logo" src="/img/svc/kadabook.webp" width="64" height="64" alt="" loading="lazy" />
                <img class="m-work-ph-ui" src={p.image} width="390" height="844" alt={`${p.name} app screen`} loading="lazy" decoding="async" />
              </div>
            ) : (
              <div class="m-work-shot">
                <span class="m-wcard-frame"><i></i><i></i><i></i><em>{p.name}</em></span>
                <img src={p.image} width="1080" height="675" alt={`Screenshot of ${p.name}`} loading="lazy" decoding="async" />
              </div>
            )}
            <div class="m-work-body">
              <div><b>{p.name}</b><small>{p.status ?? p.kind}</small></div>
              {p.url && <a class="m-pill-btn" href={p.url} target="_blank" rel="noopener">Visit</a>}
            </div>
            <p>{p.summary}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ───────── ABOUT ───────── -->
    <section class="m-tab" data-tab="about" aria-label="About" hidden>
      <div class="m-about-card">
        <img src="/img/logo-dark.webp" width="640" height="258" alt="SMART [PVT] LTD" loading="lazy" />
        <p>{company.description}</p>
      </div>

      <div class="m-vm">
        <div class="m-rv"><span class="t3d tone-blue" style="--s:40px"><Icon name="eye" size={20} stroke={2} /></span><small>Vision</small><p>{company.vision}</p></div>
        <div class="m-rv"><span class="t3d tone-pink" style="--s:40px"><Icon name="target" size={20} stroke={2} /></span><small>Mission</small><p>{company.mission}</p></div>
      </div>

      <div class="m-sec-h m-rv"><h3>How a project works</h3></div>
      <ol class="m-steps">
        {process.map((p, i) => (
          <li class="m-rv" style={`--d:${i}`}>
            <span class={`t3d tone-${stepTones[i]}`} style="--s:40px">{i + 1}</span>
            <span><b>{p.title}</b><small>{p.text}</small></span>
          </li>
        ))}
      </ol>

      {visibleTestimonials.length > 0 && (
        <>
          <div class="m-sec-h m-rv"><h3>What clients say</h3></div>
          <div class="m-carousel">
            {visibleTestimonials.map((t) => (
              <figure class="m-quote">
                <span class="m-qmark" aria-hidden="true">{'“'}</span>
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  <img src={t.photo} width="44" height="44" alt={t.name} loading="lazy" />
                  <span><b>{t.name}</b><small>{t.role}</small></span>
                </figcaption>
              </figure>
            ))}
          </div>
        </>
      )}

      <div class="m-sec-h m-rv"><h3>Questions</h3></div>
      <div class="m-group m-faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}<Icon name="chev" size={16} stroke={2.4} class="m-chev" /></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <ul class="m-group">
        <li>
          {c.googleReviewUrl ? (
            <a class="m-cell m-cell-btn" href={c.googleReviewUrl} target="_blank" rel="noopener">
              <span class="t3d tone-amber" style="--s:34px"><Icon name="star" size={17} stroke={2} /></span>
              <span class="m-cell-main"><b>SMART on Google</b><small>Reviews, photos and directions</small></span>
              <Icon name="chev" size={16} stroke={2.4} class="m-chev" />
            </a>
          ) : isDev ? (
            <span class="m-cell"><span class="dev-flag">Add googleReviewUrl in src/data/site.ts</span></span>
          ) : null}
        </li>
      </ul>
    </section>

    <!-- ───────── CONTACT ───────── -->
    <section class="m-tab" data-tab="contact" aria-label="Contact" hidden>
      <div class="m-contact-card">
        <span class="m-avatar"><img src="/img/head-180.webp" width="180" height="180" alt="" loading="lazy" /></span>
        <h2>SMART [PVT] LTD</h2>
        <p>{company.tagline}</p>
        <div class="m-actions">
          <a href={waLink('Hi SMART!')} target="_blank" rel="noopener"><span class="t3d tone-wa"><Icon name="whatsapp" size={22} stroke={1.9} /></span>message</a>
          <a href={`tel:${c.phone}`}><span class="t3d tone-blue"><Icon name="call" size={22} stroke={1.9} /></span>call</a>
          <a href={`mailto:${c.email}`}><span class="t3d tone-violet"><Icon name="mail" size={22} stroke={1.9} /></span>mail</a>
          <a href={directionsUrl} target="_blank" rel="noopener"><span class="t3d tone-orange"><Icon name="navigate" size={22} stroke={1.9} /></span>visit</a>
        </div>
      </div>

      <ul class="m-group m-info">
        <li><a class="m-cell m-cell-btn" href={`tel:${c.phone}`}><span class="t3d tone-blue" style="--s:34px"><Icon name="call" size={17} stroke={2} /></span><span class="m-cell-main"><small>Phone and WhatsApp</small><b>{c.phoneDisplay}</b></span></a></li>
        <li><a class="m-cell m-cell-btn" href={`mailto:${c.email}`}><span class="t3d tone-violet" style="--s:34px"><Icon name="mail" size={17} stroke={2} /></span><span class="m-cell-main"><small>Email</small><b>{c.email}</b></span></a></li>
        <li><a class="m-cell m-cell-btn" href={directionsUrl} target="_blank" rel="noopener"><span class="t3d tone-orange" style="--s:34px"><Icon name="pin" size={17} stroke={2} /></span><span class="m-cell-main"><small>Office</small><b>{mapQuery}</b></span></a></li>
        <li><span class="m-cell"><span class="t3d tone-indigo" style="--s:34px"><Icon name="clock" size={17} stroke={2} /></span><span class="m-cell-main"><small>Hours</small><b>{c.hours.map((h) => <>{h.days}: <span class="nw">{h.time}</span><br /></>)}</b></span></span></li>
      </ul>

      <div class="m-card m-follow m-rv">
        <div class="m-card-h"><span class="t3d tone-pink" style="--s:34px"><Icon name="heart" size={17} stroke={2} /></span><b>Follow SMART</b></div>
        <Social size="lg" />
      </div>

      <a class="m-map m-rv" href={directionsUrl} target="_blank" rel="noopener" aria-label="Get directions to SMART on Google Maps">
        <iframe title="SMART office on the map" loading="lazy" tabindex="-1" aria-hidden="true" referrerpolicy="no-referrer-when-downgrade"
          src={`https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=16&output=embed`}></iframe>
        <span class="m-map-pin" aria-hidden="true"><img src="/img/head-180.webp" width="36" height="36" alt="" /></span>
        <span class="m-map-bar"><span class="t3d tone-orange" style="--s:36px"><Icon name="navigate" size={18} stroke={2} /></span><span><b>Get directions</b><small>Opens Google Maps from your location</small></span><Icon name="chev" size={18} stroke={2.4} /></span>
      </a>

      <div class="m-sec-h m-rv"><h3>Send a message</h3></div>
      <form class="m-group m-form" data-wa-form novalidate>
        <label class="m-cell"><span class="sr-only">Your name</span><input name="name" placeholder="Your name" autocomplete="name" required /></label>
        <label class="m-cell"><span class="sr-only">Business name</span><input name="business" placeholder="Business name (optional)" autocomplete="organization" /></label>
        <label class="m-cell m-select"><span>Service</span>
          <select name="service">
            {services.map((s) => <option>{s.name}</option>)}
            <option>Something else</option>
          </select>
        </label>
        <label class="m-cell"><span class="sr-only">Message</span><textarea name="message" rows="3" placeholder="Tell us a little about your business"></textarea></label>
      </form>
      <div class="m-pad">
        <button class="m-btn m-btn-fill wide" type="button" data-wa-submit><Icon name="whatsapp" size={20} stroke={1.9} />Send on WhatsApp</button>
      </div>

      <ul class="m-group">
        <li><a class="m-cell m-cell-btn" href="/privacy-policy"><span class="t3d tone-green" style="--s:34px"><Icon name="shield" size={17} stroke={2} /></span><span class="m-cell-main"><b>Privacy Policy</b></span><Icon name="chev" size={16} stroke={2.4} class="m-chev" /></a></li>
        <li><a class="m-cell m-cell-btn" href="/terms"><span class="t3d tone-slate" style="--s:34px"><Icon name="book" size={17} stroke={2} /></span><span class="m-cell-main"><b>Terms and Conditions</b></span><Icon name="chev" size={16} stroke={2.4} class="m-chev" /></a></li>
      </ul>
      <p class="m-foot-note">© {year} {company.legalName}<br />findoursmart.com</p>
    </section>
  </main>

  <nav class="m-tabbar" aria-label="Sections">
    <span class="m-tab-ind" aria-hidden="true"></span>
    {tabs.map((t) => (
      <a href={`#${t.id}`} class:list={['m-tabbtn', { on: t.id === 'home' }]} data-tabbtn={t.id} aria-current={t.id === 'home' ? 'page' : undefined}>
        <Icon name={t.icon} size={24} stroke={1.8} />
        <span>{t.label}</span>
      </a>
    ))}
  </nav>

  <div class="m-sheet-wrap" data-sheet-wrap hidden>
    <div class="m-backdrop" data-sheet-close></div>
    <div class="m-sheet" role="dialog" aria-modal="true" aria-labelledby="m-sheet-title" tabindex="-1" data-sheet>
      <div class="m-grabber" data-grabber><span></span></div>
      <div class="m-sheet-scroll" data-sheet-scroll>
        <div class="m-sheet-hero">
          <span class="m-logo xl" data-s="icon"></span>
          <button type="button" class="m-x" data-sheet-close aria-label="Close"><Icon name="close" size={16} stroke={2.6} /></button>
          <h2 id="m-sheet-title" data-s="name"></h2>
          <p class="m-sheet-short" data-s="short"></p>
        </div>
        <div class="m-price-card">
          <div><small>Price range</small><b><Price vAttrs={{ "data-s": "price" }} /></b></div>
          <div data-s="delivery-wrap"><small>Ready in</small><b data-s="delivery"></b></div>
        </div>
        <p class="m-sheet-note" data-s="note"></p>
        <h3 class="m-group-h">What you get</h3>
